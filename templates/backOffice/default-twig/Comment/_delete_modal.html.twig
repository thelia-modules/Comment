{# Delete confirmation. The CSRF token travels in the form body. #}
<div class="modal fade" id="comment-delete-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="POST" action="{{ path('comment_module_delete') }}" class="modal-content">
            <input type="hidden" name="_token" value="{{ assignToken() }}">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Delete comment'|trans({}, 'comment.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">{{ 'Do you really want to delete this comment ?'|trans({}, 'comment.bo.default') }}</p>
                <input type="hidden" name="comment_id" id="comment-delete-id" value="">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-danger" data-testid="comment-delete-confirm">{{ 'Delete'|trans }}</button>
            </div>
        </form>
    </div>
</div>
