{#
    Comment table, shared by the full list page and the product/content edit tab.

    rows        rows built by CommentListPresenter
    statuses    status catalog (value, label, css)
    filters     CommentListFilters currently applied
    paginate    render the pager (list page) or not (edit tab)
    pageCount   number of pages
    list_route  route the pager and the filter form target
#}
{% set paginate = paginate|default(false) %}
{% set list_route = list_route|default('comment_module_default') %}

<div class="table-responsive">
    <table class="table table-striped align-middle mb-0" data-testid="comment-table">
        <thead>
            <tr>
                <th scope="col">{{ 'ID'|trans({}, 'comment.bo.default') }}</th>
                <th scope="col">{{ 'Author'|trans({}, 'comment.bo.default') }}</th>
                <th scope="col">{{ 'Comment'|trans({}, 'comment.bo.default') }}</th>
                <th scope="col">{{ 'Reference'|trans({}, 'comment.bo.default') }}</th>
                <th scope="col" class="text-end">{{ 'Actions'|trans({}, 'comment.bo.default') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr data-testid="comment-row-{{ row.id }}">
                    <td>{{ row.id }}</td>

                    <td>
                        {% if row.author.customerUrl %}
                            <a href="{{ row.author.customerUrl }}">{{ row.author.name }}</a>
                        {% else %}
                            <span class="badge text-bg-light">{{ 'not a customer'|trans({}, 'comment.bo.default') }}</span><br>
                            {{ row.author.name }}
                        {% endif %}
                        {% if row.author.email %}
                            <div class="small text-muted">
                                <a href="mailto:{{ row.author.email }}">{{ row.author.email }}</a>
                            </div>
                        {% endif %}
                    </td>
                    <td>
                        <div class="fw-semibold">{{ row.title }}</div>
                        <p class="mb-1" style="white-space: wrap">{{ row.content }}</p>
                        <ul class="list-inline small text-muted mb-0">
                            <li class="list-inline-item">
                                {{ 'Posted: '|trans({}, 'comment.bo.default') }}
                                <strong>{{ row.createdAt ? row.createdAt|date('d/m/Y H:i') : '' }}</strong>
                            </li>
                            <li class="list-inline-item">
                                {{ 'rating: '|trans({}, 'comment.bo.default') }}<strong>{{ row.rating }}</strong>
                            </li>
                            <li class="list-inline-item">
                                {{ 'verified: '|trans({}, 'comment.bo.default') }}
                                <strong>
                                    {{ row.verified
                                        ? 'yes'|trans({}, 'comment.bo.default')
                                        : 'no'|trans({}, 'comment.bo.default') }}
                                </strong>
                            </li>
                        </ul>
                    </td>

                    <td>
                        {% if row.reference.viewUrl %}<a href="{{ row.reference.viewUrl }}">{% endif %}
                        {{ row.reference.title }}
                        <span class="text-muted">({{ row.reference.ref }}: {{ row.reference.refId }})</span>
                        {% if row.reference.viewUrl %}</a>{% endif %}
                    </td>

                    <td class="text-end">
                        <div class="btn-group btn-group-sm mb-1">
                            <button type="button"
                                    class="btn btn-{{ row.status.css }} dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    data-testid="comment-status-{{ row.id }}">
                                {{ row.status.label }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                {% for status in statuses %}
                                    <li>
                                        <button type="button"
                                                class="dropdown-item"
                                                data-comment-status-change
                                                data-comment-id="{{ row.id }}"
                                                data-comment-status="{{ status.value }}">
                                            {{ status.label }}
                                        </button>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>

                        <div class="btn-group btn-group-sm">
                            <a href="{{ row.editUrl }}"
                               class="btn btn-outline-secondary"
                               title="{{ 'Change this comment'|trans({}, 'comment.bo.default') }}">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#comment-delete-modal"
                                    data-comment-id="{{ row.id }}"
                                    title="{{ 'Delete this comment'|trans({}, 'comment.bo.default') }}">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-muted">
                        {{ 'No comment yet.'|trans({}, 'comment.bo.default') }}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% if paginate and pageCount > 1 %}
    <nav aria-label="{{ 'Pagination'|trans({}, 'comment.bo.default') }}" class="mt-3">
        <ul class="pagination pagination-sm mb-0">
            {% for page in 1..pageCount %}
                <li class="page-item {{ page == filters.page ? 'active' }}">
                    <a class="page-link"
                       href="{{ path(list_route, filters.toQueryParams()|merge({page: page})) }}">{{ page }}</a>
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endif %}
