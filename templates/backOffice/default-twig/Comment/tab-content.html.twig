<div class="row">
    <div class="col-md-12">
        <h4 class="h5">{{ 'Comments activation.'|trans({}, 'comment.bo.default') }}</h4>

        <div class="mb-4" data-comment-activation="{{ path('comment_module_activation', {ref: ref, refId: id}) }}">
            <label for="comment-activation-status" class="form-label">
                {{ 'Status :'|trans({}, 'comment.bo.default') }}
            </label>
            <div class="input-group" style="max-width: 32rem;">
                <select id="comment-activation-status" class="form-select">
                    <option value="-1" {{ activated == '-1' ? 'selected' }}>
                        {{ 'Use global configuration'|trans({}, 'comment.bo.default') }}
                    </option>
                    <option value="0" {{ activated == '0' ? 'selected' }}>
                        {{ 'Deactivated for this element'|trans({}, 'comment.bo.default') }}
                    </option>
                    <option value="1" {{ activated == '1' ? 'selected' }}>
                        {{ 'Activated for this element'|trans({}, 'comment.bo.default') }}
                    </option>
                </select>
                <button type="button" class="btn btn-outline-secondary" data-comment-activation-save>
                    {{ 'Save'|trans }}
                </button>
            </div>
            <div class="form-text" data-comment-activation-feedback></div>
        </div>

        {% include 'Comment/_comments_table.html.twig' with {paginate: false} %}

        <div class="mt-3">
            <a href="{{ path('comment_module_default', {loop_status: ''}) }}" class="btn btn-sm btn-outline-secondary">
                {{ 'Comments management'|trans({}, 'comment.bo.default') }}
            </a>
        </div>
    </div>
</div>

{% include 'Comment/_delete_modal.html.twig' %}
{% include 'Comment/_list_scripts.html.twig' %}

<script>
    (function () {
        const container = document.querySelector('[data-comment-activation]');

        if (!container) {
            return;
        }

        const select = container.querySelector('select');
        const feedback = container.querySelector('[data-comment-activation-feedback]');

        container.querySelector('[data-comment-activation-save]').addEventListener('click', function () {
            const body = new FormData();
            body.append('status', select.value);

            fetch(container.dataset.commentActivation, {method: 'POST', body: body, credentials: 'same-origin'})
                .then(function (response) { return response.json(); })
                .then(function (result) {
                    feedback.textContent = result.success
                        ? {{ 'Saved'|trans({}, 'comment.bo.default')|json_encode|raw }}
                        : (result.error || '');
                })
                .catch(function () {
                    feedback.textContent = {{ 'Please contact your administrator or try later'|trans({}, 'comment.bo.default')|json_encode|raw }};
                });
        });
    })();
</script>
